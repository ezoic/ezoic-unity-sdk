# CI-only harness used by the `cocoapods-bridge` job: compiles
# Runtime/Plugins/iOS/*.swift against the CocoaPods build of EzoicAdsSDK, the
# artifact EDM installs into a Unity Xcode project when it falls back to
# CocoaPods (Swift module EzoicAdsSDKBinary). The `~` folder suffix keeps Unity
# from importing anything here, including the generated Pods/ tree.
#
# `pod install` generates BridgeCheck.xcodeproj itself (one framework target that
# references the bridge sources in place), so nothing generated is committed.
# The native version and deployment target are read from
# Editor/EzoicDependencies.xml: the pod is the exact version the
# remoteSwiftPackage element pins, installed from the podspec on that
# ezoic-swift-sdk-dist tag so it does not depend on CocoaPods trunk (read-only
# from December 2, 2026). Set EZOIC_PODSPEC_REF to read the podspec from another
# dist ref.
#
#   cd "tools/cocoapods-check~" && pod install
#   xcodebuild build -workspace BridgeCheck.xcworkspace -scheme EzoicUnityBridgeCheck \
#     -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO

require 'rexml/document'
require 'xcodeproj'

repo_root = File.expand_path('../..', __dir__)

deps = REXML::Document.new(File.read(File.join(repo_root, 'Editor', 'EzoicDependencies.xml')))
swift_package = REXML::XPath.first(deps, "//remoteSwiftPackage[swiftPackage/@name='EzoicAdsSDK']")
raise 'EzoicAdsSDK remoteSwiftPackage not found in Editor/EzoicDependencies.xml' unless swift_package
native_version = swift_package.attributes['version']
ios_pod = REXML::XPath.first(deps, "//iosPod[@name='EzoicAdsSDK']")
raise 'EzoicAdsSDK iosPod not found in Editor/EzoicDependencies.xml' unless ios_pod
pod_requirement = ios_pod.attributes['version']
deployment_target = ios_pod.attributes['minTargetSdk']

unless Pod::Requirement.create(pod_requirement).satisfied_by?(Pod::Version.new(native_version))
  raise "iosPod requirement '#{pod_requirement}' does not admit remoteSwiftPackage version #{native_version}"
end

podspec_ref = ENV.fetch('EZOIC_PODSPEC_REF', native_version)
podspec_url = "https://raw.githubusercontent.com/ezoic/ezoic-swift-sdk-dist/#{podspec_ref}/EzoicAdsSDK.podspec"

bridge_sources = Dir[File.join(repo_root, 'Runtime', 'Plugins', 'iOS', '*.swift')].sort
raise 'No Swift bridge sources found under Runtime/Plugins/iOS' if bridge_sources.empty?

target_name = 'EzoicUnityBridgeCheck'
project_path = File.join(__dir__, 'BridgeCheck.xcodeproj')
project = Xcodeproj::Project.new(project_path)
target = project.new_target(:framework, target_name, :ios, deployment_target)
group = project.main_group.new_group('Bridge')
target.add_file_references(bridge_sources.map { |path| group.new_file(path) })
target.build_configurations.each do |config|
  config.build_settings['SWIFT_VERSION'] = '5.0'
  config.build_settings['PRODUCT_BUNDLE_IDENTIFIER'] = 'com.ezoic.unity.bridgecheck'
  config.build_settings['GENERATE_INFOPLIST_FILE'] = 'YES'
  config.build_settings['CURRENT_PROJECT_VERSION'] = '1'
  config.build_settings['MARKETING_VERSION'] = '1.0'
  config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
end
project.save
scheme = Xcodeproj::XCScheme.new
scheme.add_build_target(target)
scheme.save_as(project_path, target_name, true)

platform :ios, deployment_target
project project_path
# Mirrors EDM's default "Link frameworks statically" Podfile.
use_frameworks! :linkage => :static

target target_name do
  pod 'EzoicAdsSDK', :podspec => podspec_url
end

# Dist tags before 1.20.0 carry the previous release's podspec, so a tag's
# podspec is not guaranteed to describe the tag's version.
pre_install do |installer|
  spec = installer.analysis_result.specifications.find { |s| s.name == 'EzoicAdsSDK' }
  unless spec && spec.version.to_s == native_version
    raise "#{podspec_url} declares EzoicAdsSDK #{spec&.version || 'nothing'}, expected #{native_version}"
  end
  Pod::UI.puts "EzoicAdsSDK #{spec.version} from #{podspec_url}"
end
