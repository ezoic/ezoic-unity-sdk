<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-only project for the iOS build variant of the Ezoic Ads Unity SDK.
    This is NOT how Unity builds the package (Unity uses the .asmdef files); it exists
    purely so CI and local developers can type-check the Runtime C# against the Unity
    managed assemblies without opening the Unity editor.

    With UNITY_IOS (and no UNITY_EDITOR) the iOS device path is active: Runtime/iOS/*.cs
    compiles and the ad classes take their #elif UNITY_IOS branch. The Android bridge
    files are fully wrapped in #if UNITY_ANDROID && !UNITY_EDITOR, so the shared
    Runtime/**/*.cs glob picks them up but they compile to nothing here — exactly like
    the Editor variant. That is why this project needs no AndroidJNIModule reference.

    Usage:
      dotnet build tools/compile/Ezoic.Ads.iOS.csproj \
        -p:UnityManagedPath=$HOME/.local/toolchains/unity-managed-2022.3.62f3
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Ezoic.Ads</AssemblyName>
    <RootNamespace>Ezoic.Ads</RootNamespace>
    <!-- iOS player build: device code path is active, editor stub is excluded. -->
    <DefineConstants>UNITY_IOS;UNITY_2022_3_OR_NEWER</DefineConstants>
    <!-- Override on the command line: -p:UnityManagedPath=/path/to/Managed/UnityEngine -->
    <UnityManagedPath Condition="'$(UnityManagedPath)' == ''">$(UNITY_MANAGED_PATH)</UnityManagedPath>
  </PropertyGroup>

  <Target Name="_EzoicCheckUnityManagedPath" BeforeTargets="BeforeCompile">
    <Error
      Condition="'$(UnityManagedPath)' == '' or !Exists('$(UnityManagedPath)/UnityEngine.CoreModule.dll')"
      Text="UnityManagedPath is not set or does not contain UnityEngine.CoreModule.dll. Pass -p:UnityManagedPath=/path/to/Editor/Data/Managed/UnityEngine (got: '$(UnityManagedPath)')." />
  </Target>

  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs" />
    <Compile Include="../../Samples~/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>$(UnityManagedPath)/UnityEngine.SharedInternalsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
