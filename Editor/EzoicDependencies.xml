<?xml version="1.0" encoding="UTF-8"?>
<!--
  External Dependency Manager (EDM / EDM4U) dependency manifest.
  Declares the native Ezoic Ads libraries so the resolvers add them to the
  generated builds: the Android Resolver adds the Maven package to Gradle
  (com.ezoic.sdk:ezoic-cmp-sdk comes with it), and the iOS Resolver adds the
  Swift package to the generated Xcode project. iOS needs Swift Package Manager
  Integration on (EDM4U 1.2.187+, Unity's EDM 2.1+): from 1.22.0 there is no
  CocoaPod to fall back to, because CocoaPods trunk stopped at 1.19.1.
  If your project does not use EDM, add the equivalent dependencies to your
  mainTemplate.gradle / Xcode project manually (see README).
-->
<dependencies>
  <androidPackages>
    <androidPackage spec="com.ezoic.sdk:ezoic-ads-sdk:1.22.0">
      <repositories>
        <repository>https://repo1.maven.org/maven2</repository>
      </repositories>
    </androidPackage>
  </androidPackages>
  <!-- replacesPod: skip a trunk EzoicAdsSDK pod some other manifest might still declare. -->
  <remoteSwiftPackage url="https://github.com/ezoic/ezoic-swift-sdk-dist.git" version="1.22.0" upToNextMajor="true">
    <swiftPackage name="EzoicAdsSDK" replacesPod="EzoicAdsSDK" />
  </remoteSwiftPackage>
</dependencies>
