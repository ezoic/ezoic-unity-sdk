<?xml version="1.0" encoding="UTF-8"?>
<!--
  External Dependency Manager (EDM / EDM4U) dependency manifest.
  Declares the native Ezoic Ads libraries so the resolvers add them to the
  generated builds: the Android Resolver adds the Maven package to Gradle, and
  the iOS Resolver adds the Swift package to the generated Xcode project. When
  Swift Package Manager Integration is off, or the EDM4U version predates Swift
  package support (1.2.187), the iOS Resolver ignores remoteSwiftPackage and
  adds the CocoaPod to the Podfile instead.
  If your project does not use EDM, add the equivalent dependencies to your
  mainTemplate.gradle / Xcode project / Podfile manually (see README).
-->
<dependencies>
  <androidPackages>
    <androidPackage spec="com.ezoic.sdk:ezoic-ads-sdk:1.19.1">
      <repositories>
        <repository>https://repo1.maven.org/maven2</repository>
      </repositories>
    </androidPackage>
  </androidPackages>
  <remoteSwiftPackage url="https://github.com/ezoic/ezoic-swift-sdk-dist.git" version="1.19.2" upToNextMajor="true">
    <swiftPackage name="EzoicAdsSDK" replacesPod="EzoicAdsSDK" />
  </remoteSwiftPackage>
  <iosPods>
    <iosPod name="EzoicAdsSDK" version="~> 1.19" minTargetSdk="15.0" />
  </iosPods>
</dependencies>
