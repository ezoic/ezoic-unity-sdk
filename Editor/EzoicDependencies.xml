<?xml version="1.0" encoding="UTF-8"?>
<!--
  External Dependency Manager for Unity (EDM4U) dependency manifest.
  Declares the native Ezoic Ads libraries so EDM4U's resolvers add them to the
  generated builds: the Android Resolver adds the Maven package to Gradle, and
  the iOS Resolver adds the CocoaPod to the generated Xcode project's Podfile.
  If your project does not use EDM4U, add the equivalent lines to your
  mainTemplate.gradle / Podfile manually (see README).
-->
<dependencies>
  <androidPackages>
    <androidPackage spec="com.ezoic.sdk:ezoic-ads-sdk:1.9.0">
      <repositories>
        <repository>https://repo1.maven.org/maven2</repository>
      </repositories>
    </androidPackage>
  </androidPackages>
  <iosPods>
    <iosPod name="EzoicAdsSDK" version="~> 1.9.0" minTargetSdk="14.0" />
  </iosPods>
</dependencies>
